# Copy to dev/audiomuse/.env (gitignored) and fill in. Read by docker-compose.yml
# and scripts/audiomuse-dev.sh.

# Navidrome AudioMuse analyses (read-only Subsonic access; nothing is installed there).
NAVIDROME_URL=https://music.example.com
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# How many of the newest albums `make audiomuse-analyze` processes. Small = minutes.
NUM_RECENT_ALBUMS=10

# AudioMuse login (web UI at http://127.0.0.1:8000) and the API token
# foo_navidrome sends as "Authorization: Bearer ...".
AUDIOMUSE_USER=admin
AUDIOMUSE_PASSWORD=admin-dev-password
AUDIOMUSE_API_TOKEN=foo-navidrome-dev-token
AUDIOMUSE_JWT_SECRET=foo-navidrome-dev-jwt-secret-change-me

# The AudioMuse API is always http://127.0.0.1:8000 (port fixed in the image).
# Postgres is published on this host port (loopback only) for flask/worker.
POSTGRES_HOST_PORT=5433

# Instant Playlist LLM: the host's own Ollama (needs this model pulled:
# `ollama pull qwen3.5:9b`, AudioMuse's default). OLLAMA_URL points elsewhere.
OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_URL=http://127.0.0.1:11434/api/generate

# AUDIOMUSE_TAG=latest
TZ=UTC
